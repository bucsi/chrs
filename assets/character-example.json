    {
      "type": "group",
      "name": "Features & Traits",
      "fields": [
        {
          "type": "value",
          "name": "Darkvision",
          "value": {
            "type": "long_text",
            "value": "You can see in dim light within 60 feet of you as if it were bright light, and in darkness as if it were dim light.",
            "excerpt": "See 60 ft. in dim/darkness as bright/dim light.",
            "reference": "PHB'24 p365"
          }
        },
        {
          "type": "value",
          "name": "Fey Ancestry",
          "value": {
            "type": "long_text",
            "value": "You have advantage on saving throws against being charmed, and magic can't put you to sleep.",
            "excerpt": "Advantage vs. charm; immune to magical sleep.",
            "reference": "https://5e.tools/races.html#elf_xphb"
          }
        },
        {
          "type": "value",
          "name": "Mask of the Wild",
          "value": {
            "type": "long_text",
            "value": "You can attempt to hide when only lightly obscured by foliage, mist, etc.",
            "excerpt": "Hide when lightly obscured by natural phenomena.",
            "reference": "https://5e.tools/races.html#elf_xphb"
          }
        },
        {
          "type": "value",
          "name": "Dueling",
          "value": {
            "type": "long_text",
            "value": "When you are wielding a melee weapon in one hand and no other weapons, you gain a +2 bonus to damage rolls with that weapon.",
            "excerpt": "+2 damage with a one-handed melee weapon, no other weapons wielded.",
            "reference": "https://5e.tools/optionalfeatures.html#dueling_phb"
          }
        },
        {
          "type": "value",
          "name": "Second Wind",
          "value": {
            "type": "resource",
            "value": 1,
            "max": 1,
            "kind": "counter",
            "recovery": {
              "on": ["Short Rest", "Long Rest"],
              "kind": { "type": "to_full" }
            }
          }
        },
        {
          "type": "value",
          "name": "Action Surge",
          "value": {
            "type": "resource",
            "value": 1,
            "max": 1,
            "kind": "counter",
            "recovery": {
              "on": ["Short Rest", "Long Rest"],
              "kind": { "type": "to_full" }
            }
          }
        },
        {
          "type": "value",
          "name": "Weapon Bond",
          "value": {
            "type": "long_text",
            "value": "You perform a 1 hour ritual (which can be done during a short rest) to bond a weapon to you. You cannot be disarmed of your bonded weapon unless you are incapacitated. As a bonus action, you can teleport the weapon to your hand. You can have up to 2 bonded weapons, but can summon only one at a time with your bonus action.",
            "excerpt": "Bond a weapon; can't be disarmed; teleport it to your hand as a bonus action.",
            "reference": "https://5e.tools/classes.html#fighter_xphb"
          }
        },
        {
          "type": "value",
          "name": "Knightly Regard",
          "value": {
            "type": "long_text",
            "value": "You can receive aid from members of your knightly order and those who are sympathetic to its aims. This can include food, shelter and healing.",
            "excerpt": "Receive food, shelter, and healing from your order's members and sympathizers.",
            "reference": "https://5e.tools/optionalfeatures.html#knightly_regard_scag"
          }
        }
      ]
    },
