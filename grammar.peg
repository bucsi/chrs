CharacterSheet {
  // Lexical convention: whitespace (spaces, tabs, newlines, including
  // blank lines) is insignificant between any two tokens or literals,
  // and is skipped there implicitly — it is not written into the rules
  // below except where a rule's own definition depends on it directly
  // (e.g. TriggerPhrase's internal single space, Key's internal spaces).
  // This applies at the very start and very end of the document too.

  Sheet       = Element*
  Element     = Group | Value
  Group       = "group" Key "{" Element* "}"
  Value       = Key ":" FieldValue
  FieldValue  = Resource
              | Checkbox
              | Modifier
              | Integer
              | Link
              | ShortText
              | LongText

  Resource     = ResourceKind "{" Fraction "[" Triggers "]" RecoveryKind "}"
  ResourceKind = "resource" | "counter"
  Fraction     = digit+ "/" digit+

  Triggers      = (TriggerPhrase ("," TriggerPhrase)*)?
  TriggerPhrase = Word (" " Word)*

  RecoveryKind  = "to_full" 
                | "to_half" 
                | "to_zero" 
                | "no_change" 
                | Modifier

  // Freeform author-facing name. Anything except the structural
  // delimiters below; surrounding whitespace is trimmed.
  Key         = (~("\n" | ":" | "{" | "}") any)+
  ShortText   = Quoted
  LongText    = "{" (~"}" any)* "}"
  Quoted      = "\"" (~"\"" any)* "\""

  // Strict token used only inside TriggerPhrase.
  Word        = letter+

  Checkbox    = "On" | "Off" | "Special"
  Modifier    = ("+" | "-") digit+
  Integer     = digit+
  Link        = "<" (~">" any)* ">"
  // whitespace between tokens is always insignificant, per convention —
  // so "] (" and "](" are equivalent, no special-casing needed here
}
